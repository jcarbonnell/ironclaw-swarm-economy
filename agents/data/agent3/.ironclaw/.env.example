# === IronClaw Core ===
ONBOARD_COMPLETED=true

# === Database (This is the critical line) ===
DATABASE_URL=postgresql://ironclaw:your_database_password@postgres:5432/ironclaw_agent1?sslmode=disable

# === Network ===
NEAR_NETWORK=testnet

# === NOVA ===
NOVA_CONTRACT_ID=nova-sdk-6.testnet
KV_CONTRACT_ID=nova-kv.testnet
NOVA_ACCOUNT_ID=agent3_nova_account_id.nova-sdk-6.testnet
NOVA_API_KEY=agent3_nova_account_api_key

# === Qdrant ===
QDRANT_URL=http://qdrant:6333

# === Model ===
NEARAI_MODEL=anthropic/claude-haiku-4-5

# === HTTP Channel ===
HTTP_HOST=0.0.0.0
HTTP_PORT=8081
HTTP_WEBHOOK_SECRET=agent3_http_webhook_secret

# === Heartbeat ===
HEARTBEAT_INTERVAL=30
